      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by(le) (rate(postkeys_command_duration_seconds_bucket{namespace=~\"$namespace\", pod=~\"$pod\", command!~\"$blocking_commands\"}[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "title": "Command Latency Heatmap (all commands)",
      "type": "heatmap"
